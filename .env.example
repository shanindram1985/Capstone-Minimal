# Capstone-Minimal environment
# Copy to .env and adjust values

# Vision: cursor (recommended) | mock | openai
VISION_AGENT_PROVIDER=cursor

# Optional LLM step builder: heuristic | cursor | openai
STEP_BUILDER_PROVIDER=heuristic

# Cursor API token (Dashboard -> Integrations / API Keys)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# auto tries cloud REST first (avoids Windows local-bridge bugs), then local SDK
CURSOR_RUNTIME=cloud
# Optional: set false only behind broken corporate SSL inspection
CURSOR_SSL_VERIFY=true
# Optional GitHub repo for cloud agents that need a workspace (leave empty for no-repo vision)
CURSOR_GITHUB_REPO=
CURSOR_GITHUB_REF=master
CURSOR_CLOUD_TIMEOUT_SEC=180

# OpenAI is optional / legacy only (not required when using cursor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Appium
APPIUM_SERVER_URL=http://127.0.0.1:4723
PLATFORM_NAME=Android
PLATFORM_VERSION=14.0
AUTOMATION_NAME=UiAutomator2
DEVICE_NAME=Android Emulator
APP_PACKAGE=com.saucelabs.mydemoapp.android
APP_ACTIVITY=com.saucelabs.mydemoapp.android.view.activities.SplashActivity
APP_PATH=demo_mobile_apps/mda-2.2.0-25.apk

EXPLICIT_WAIT_TIMEOUT=15
LOG_LEVEL=INFO
